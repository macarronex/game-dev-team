{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "orchestrator",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "GAMEDEV_ENFORCE_DELEGATION": "1",
    "GAMEDEV_REQUIRE_TESTS": "1",
    "GAMEDEV_TEST_EXEMPT": "^godot/src/ui/|^godot/tools/|^godot/addons/",
    "GAMEDEV_GATE_MAX_BLOCKS": "3"
  },
  "permissions": {
    "allow": [
      "Bash(godot *)",
      "Bash(godot4 *)",
      "Bash(\"$GODOT_BIN\" *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo audit *)",
      "Bash(cargo add *)",
      "Bash(gdformat *)",
      "Bash(gdlint *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(bash .claude/hooks/quality-gate.sh *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git reset *)",
      "Bash(cargo install *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./godot/.godot/export_credentials.cfg)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(cargo publish *)",
      "Bash(npm publish *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-check.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/quality-gate.sh\" --hook",
            "timeout": 900,
            "statusMessage": "Quality gate (tests, lint, seguridad)..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/quality-gate.sh\" --hook",
            "timeout": 900,
            "statusMessage": "Quality gate (tests, lint, seguridad)..."
          }
        ]
      }
    ]
  }
}
